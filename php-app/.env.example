APP_NAME="SMOLLAN Operations Hub"
APP_ENV=local
APP_URL=http://localhost:8080
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

# Supabase publishable key is safe for Auth REST; never use a service-role key here.
SUPABASE_URL=https://ddrohraarhdbwamwnmnu.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_set_this_server_side

# PostgreSQL connection from Supabase Dashboard > Connect > Session pooler.
DB_HOST=your-session-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/path/to/supabase-prod-ca.crt

# Optional integration credentials; configure only in server environment/.env and do not commit.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SCOPES="openid email profile https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/spreadsheets.readonly"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
