APP_NAME="SMOLLAN Operations Hub"
APP_ENV=local
APP_URL=http://localhost:8080
APP_KEY=generate-a-random-32-byte-secret-before-production
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

# Supabase PostgreSQL — use the Session pooler credentials from Dashboard > Connect.
# Never commit real credentials. Keep SSL enabled and validate the server certificate in production.
DB_DRIVER=pgsql
DB_HOST=your-session-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/path/to/supabase-prod-ca.crt

# Authenticated role provisioning is performed by a platform administrator in Supabase.
# App access is denied until smollan_memberships has an active authorized role.

# Optional integrations (disabled unless all credentials are configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SCOPES="openid email profile https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/spreadsheets.readonly"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
